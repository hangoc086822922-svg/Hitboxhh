-- Hàm tự động gán ESP cho người chơi mới hoặc khi họ hồi sinh (respawn) sau trận
local function setupESP(player)
    if player == LocalPlayer then return end
    
    player.CharacterAdded:Connect(function(newCharacter)
        task.wait(0.5) -- Đợi nhân vật tải xong phần thân
        if getgenv().EspStatus then
            if Highlights[player] then
                Highlights[player]:Destroy()
                Highlights[player] = nil
            end
            
            local highlight = Instance.new("Highlight")
            highlight.Name = "ZenESP"
            highlight.Adornee = newCharacter
            highlight.FillColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
            highlight.OutlineTransparency = 0
            highlight.Parent = newCharacter
            Highlights[player] = highlight
        end
    end)
end

-- Lắng nghe người chơi mới vào hoặc đã có sẵn trong game
for _, player in ipairs(Players:GetPlayers()) do
    setupESP(player)
end
Players.PlayerAdded:Connect(setupESP)

-- Vòng lặp cập nhật liên tục ESP (không bị reset qua các trận) và Hitbox (mất khi chết)
task.spawn(function()
    while true do
        task.wait(0.2)
        pcall(function()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local character = player.Character
                    if character then
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local rootPart = character:FindFirstChild("HumanoidRootPart")
                        
                        -- 1. ESP luôn duy trì liên tục, tự động làm mới khi qua trận/hồi sinh
                        if getgenv().EspStatus then
                            if not Highlights[player] or Highlights[player].Parent ~= character then
                                if Highlights[player] then
                                    Highlights[player]:Destroy()
                                end
                                
                                local highlight = Instance.new("Highlight")
                                highlight.Name = "ZenESP"
                                highlight.Adornee = character
                                highlight.FillColor = Color3.fromRGB(255, 255, 255)
                                highlight.FillTransparency = 0.5
                                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                                highlight.OutlineTransparency = 0
                                highlight.Parent = character
                                Highlights[player] = highlight
                            end
                        else
                            if Highlights[player] then
                                Highlights[player]:Destroy()
                                Highlights[player] = nil
                            end
                        end

                        -- 2. Hitbox giữ nguyên to đậm, chỉ mất khi bị hạ gục (máu <= 0)
                        if humanoid and rootPart then
                            if not OriginalSizes[player] then
                                OriginalSizes[player] = rootPart.Size
                            end

                            if getgenv().HitboxStatus then
                                if humanoid.Health <= 0 then
                                    rootPart.Size = OriginalSizes[player]
                                    rootPart.Transparency = 1
                                else
                                    rootPart.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                    rootPart.Transparency = 0.3
                                    rootPart.Color = Color3.fromRGB(255, 255, 255)
                                    rootPart.Material = Enum.Material.ForceField
                                    rootPart.CanCollide = false
                                end
                            else
                                rootPart.Size = OriginalSizes[player]
                                rootPart.Transparency = 1
                            end
                        end
                    end
                end
            end
        end)
    end
end)
